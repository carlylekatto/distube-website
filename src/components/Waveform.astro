---
/**
 * DisTube Audio Spectrum Analyzer
 * Engineered for clarity: clean emerald frequency levels inside canvas-night chrome.
 */
interface Props {
  height?: number;
  class?: string;
  interactive?: boolean;
}

const { height = 80, class: className = "", interactive = true } = Astro.props;
---

<div class={`audio-visualizer-container ${className}`} data-interactive={interactive ? "true" : "false"}>
  <canvas class="audio-visualizer-canvas" height={height * 2}></canvas>
</div>

<script>
  function initVisualizers() {
    const containers = document.querySelectorAll<HTMLElement>(".audio-visualizer-container");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    containers.forEach((container) => {
      const canvas = container.querySelector<HTMLCanvasElement>(".audio-visualizer-canvas");
      if (!canvas) return;

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      let animationId: number;
      let width = 0;
      let height = 0;
      const barCount = 44;
      const bars: { height: number; target: number; phase: number }[] = [];

      for (let i = 0; i < barCount; i++) {
        bars.push({
          height: 10 + Math.random() * 20,
          target: 15 + Math.random() * 32,
          phase: Math.random() * Math.PI * 2,
        });
      }

      function resize() {
        if (!canvas) return;
        const rect = container.getBoundingClientRect();
        width = rect.width;
        height = rect.height || 80;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx?.scale(dpr, dpr);
      }

      let time = 0;
      let hoveredIndex = -1;

      if (container.dataset.interactive === "true") {
        container.addEventListener("mousemove", (e) => {
          const rect = container.getBoundingClientRect();
          const paddingX = Math.max(12, Math.min(20, width * 0.04));
          const availWidth = width - paddingX * 2;
          const x = e.clientX - rect.left - paddingX;
          if (x >= 0 && x <= availWidth) {
            hoveredIndex = Math.floor((x / availWidth) * barCount);
          } else {
            hoveredIndex = -1;
          }
        });

        container.addEventListener("mouseleave", () => {
          hoveredIndex = -1;
        });
      }

      function draw() {
        if (!ctx) return;
        ctx.clearRect(0, 0, width, height);

        const paddingX = Math.max(12, Math.min(20, width * 0.04));
        const availWidth = width - paddingX * 2;
        const barWidth = Math.max(2.5, (availWidth / barCount) * 0.6);
        const gap = (availWidth - barWidth * barCount) / (barCount - 1);
        const centerY = height / 2;
        const maxAmplitude = height - 16;

        time += 0.035;

        // Signature Supabase Emerald
        const primaryEmerald = "rgba(62, 207, 142, ";
        const softEmerald = "rgba(74, 222, 128, ";

        for (let i = 0; i < barCount; i++) {
          const bar = bars[i];
          const wave1 = Math.sin(time * 2.2 + i * 0.24) * Math.cos(time * 1.2 + i * 0.14);
          const wave2 = Math.sin(time * 3.4 + bar.phase) * 0.5;
          const envelope = Math.sin((i / (barCount - 1)) * Math.PI);
          
          let target = (12 + (Math.abs(wave1) * 36 + wave2 * 10)) * envelope;
          
          if (hoveredIndex !== -1) {
            const dist = Math.abs(i - hoveredIndex);
            if (dist < 6) {
              target += (6 - dist) * 8;
            }
          }

          if (prefersReducedMotion) {
            target = 20 * envelope;
          }

          bar.height += (target - bar.height) * 0.12;
          const currentH = Math.max(6, Math.min(maxAmplitude, bar.height));
          const x = paddingX + i * (barWidth + gap);
          const y = centerY - currentH / 2;
          const radius = Math.min(barWidth / 2, 3);

          // Vertical gradient: soft emerald top/bottom, vibrant emerald core
          const grad = ctx.createLinearGradient(0, y, 0, y + currentH);
          grad.addColorStop(0, `${softEmerald}0.95)`);
          grad.addColorStop(0.5, `${primaryEmerald}0.85)`);
          grad.addColorStop(1, `${softEmerald}0.95)`);

          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.roundRect(x, y, barWidth, currentH, radius);
          ctx.fill();
        }

        if (!prefersReducedMotion) {
          animationId = requestAnimationFrame(draw);
        }
      }

      resize();
      draw();

      const ro = new ResizeObserver(() => {
        resize();
        if (prefersReducedMotion) draw();
      });
      ro.observe(container);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initVisualizers);
  } else {
    initVisualizers();
  }
  document.addEventListener("astro:page-load", initVisualizers);
</script>

<style>
  .audio-visualizer-container {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .audio-visualizer-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
