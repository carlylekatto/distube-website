---
/**
 * DisTube Audio Spectrum Analyzer
 *
 * The bars of a spectrum analyser of a studio device: a quiet layer of
 * levels, a slow scan that crosses them, and a bump under the pointer.
 */
interface Props {
  height?: number;
  class?: string;
  interactive?: boolean;
}

const { height = 80, class: className = "", interactive = true } = Astro.props;
---

<div class={`audio-visualizer-container ${className}`} data-interactive={interactive ? "true" : "false"}>
  <canvas class="audio-visualizer-canvas" height={height * 2}></canvas>
</div>

<script>
  function initVisualizers() {
    const containers = document.querySelectorAll<HTMLElement>(".audio-visualizer-container");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    containers.forEach((container) => {
      const canvas = container.querySelector<HTMLCanvasElement>(".audio-visualizer-canvas");
      if (!canvas) return;

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      const barCount = 44;
      let width = 0;
      let height = 0;

      // Every bar has its own rhythm, so the levels never look like a single
      // wave repeated.
      const bars = Array.from({ length: barCount }, () => ({
        level: 12 + Math.random() * 18,
        phase: Math.random() * Math.PI * 2,
        speed: 0.6 + Math.random() * 0.9,
        depth: 0.4 + Math.random() * 0.8,
      }));

      function resize() {
        const rect = container.getBoundingClientRect();
        width = rect.width;
        height = rect.height || 80;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx?.scale(dpr, dpr);
      }

      let time = 0;
      let scan = 0;
      let hoveredIndex = -1;

      if (container.dataset.interactive === "true") {
        container.addEventListener("mousemove", (e) => {
          const rect = container.getBoundingClientRect();
          const paddingX = Math.max(12, Math.min(20, width * 0.04));
          const availWidth = width - paddingX * 2;
          const x = e.clientX - rect.left - paddingX;
          hoveredIndex = x >= 0 && x <= availWidth ? Math.floor((x / availWidth) * barCount) : -1;
        });

        container.addEventListener("mouseleave", () => {
          hoveredIndex = -1;
        });
      }

      function draw() {
        if (!ctx) return;
        ctx.clearRect(0, 0, width, height);

        const paddingX = Math.max(12, Math.min(20, width * 0.04));
        const availWidth = width - paddingX * 2;
        const barWidth = Math.max(2.5, (availWidth / barCount) * 0.6);
        const gap = (availWidth - barWidth * barCount) / (barCount - 1);
        const centerY = height / 2;
        const maxAmplitude = height - 16;

        time += 0.016;
        // The scan crosses the bars, and lifts them as it goes.
        scan = (scan + 0.0045) % 1;

        const primary = "rgba(62, 207, 142, ";
        const soft = "rgba(74, 222, 128, ";

        ctx.shadowColor = "rgba(62, 207, 142, 0.45)";
        ctx.shadowBlur = 10;

        for (let i = 0; i < barCount; i++) {
          const bar = bars[i];
          const position = i / (barCount - 1);

          // Three layers at different speeds: the levels of a track, not a
          // sine wave.
          const slow = Math.sin(time * bar.speed + bar.phase);
          const quick = Math.sin(time * bar.speed * 2.7 + bar.phase * 1.9) * 0.4;
          const drift = Math.sin(time * 0.31 + position * 3.1) * 0.5;

          // The envelope keeps the ends of the spectrum lower.
          const envelope = 0.35 + Math.sin(position * Math.PI) * 0.65;

          let target = (14 + (slow * 16 + quick * 12 + drift * 8 + 18) * bar.depth) * envelope;

          // The scan.
          const distance = Math.abs(position - scan);
          const near = distance < 0.16 ? (1 - distance / 0.16) * 26 : 0;
          target += near;

          // The pointer.
          if (hoveredIndex !== -1) {
            const d = Math.abs(i - hoveredIndex);
            if (d < 7) target += (7 - d) * 7;
          }

          if (prefersReducedMotion) target = 20 * envelope;

          bar.level += (target - bar.level) * 0.12;
          const level = Math.max(6, Math.min(maxAmplitude, bar.level));
          const x = paddingX + i * (barWidth + gap);
          const y = centerY - level / 2;
          const radius = Math.min(barWidth / 2, 3);

          const gradient = ctx.createLinearGradient(0, y, 0, y + level);
          gradient.addColorStop(0, `${soft}0.95)`);
          gradient.addColorStop(0.5, `${primary}0.9)`);
          gradient.addColorStop(1, `${soft}0.95)`);

          ctx.fillStyle = gradient;
          ctx.beginPath();
          ctx.roundRect(x, y, barWidth, level, radius);
          ctx.fill();
        }

        ctx.shadowBlur = 0;

        if (!prefersReducedMotion) {
          requestAnimationFrame(draw);
        }
      }

      resize();
      draw();

      const observer = new ResizeObserver(() => {
        resize();
        if (prefersReducedMotion) draw();
      });
      observer.observe(container);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initVisualizers);
  } else {
    initVisualizers();
  }
  document.addEventListener("astro:page-load", initVisualizers);
</script>

<style>
  .audio-visualizer-container {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .audio-visualizer-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
