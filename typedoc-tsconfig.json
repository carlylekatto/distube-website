{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "paths": {
      "@/*": ["./source/src/*"],
      "@": ["./source/src/index.ts"]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "target": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["./source/src/**/*.ts"]
}
